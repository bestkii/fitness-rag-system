# Optional. The application runs in offline extractive mode without this value.
DEEPSEEK_API_KEY=replace-with-your-own-key

# Research defaults to the free PubMed + Crossref public APIs.
# Set RESEARCH_PROVIDER=brave only if you intentionally want to use your own paid key.
# RESEARCH_PROVIDER=academic
# BRAVE_SEARCH_API_KEY=replace-with-your-own-key

# Optional polite-pool contact details for public academic APIs.
# NCBI_CONTACT_EMAIL=you@example.com
# CROSSREF_CONTACT_EMAIL=you@example.com

# Xiaohongshu collector uses the locally installed Chrome browser by default.
# XHS_BROWSER_CHANNEL=chrome

# Optional content-model override. Defaults to DeepSeek-compatible settings.
# CONTENT_API_KEY=replace-with-your-own-key
# CONTENT_API_BASE=https://api.deepseek.com
# CONTENT_MODEL=deepseek-chat

# Optional comma-separated additions to the built-in trusted-source list.
# TRUSTED_SOURCE_DOMAINS=example-university.edu,example-association.org
